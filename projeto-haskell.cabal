cabal-version:      3.0
name:               projeto-haskell
version:            0.1.0.0
build-type:         Simple
synopsis:           IA para geracao de casos de teste em Haskell
description:
  Modelo de verificacao de CPF com entradas geradas por algoritmo
  genetico e avaliacao via Hspec.

library
    exposed-modules:  Cpf.Validador
                    , Gen.Algoritmo
    hs-source-dirs:   src
    build-depends:    base ^>=4.20.2.0
    default-language: Haskell2010

executable projeto-haskell
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base ^>=4.20.2.0
                    , projeto-haskell
    default-language: Haskell2010
